.env.*
config/config.local.yaml
config_shijingbo.json
config_shijingbo.yaml

# IDE
.idea
.vscode
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# macOS binary libraries
*.dylib

# 依赖目录
dist/
node_modules/
vendor/

# Go workspaces（个人环境配置）
go.work.sum
